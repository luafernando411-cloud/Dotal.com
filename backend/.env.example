POSTGRES_DB=census
POSTGRES_USER=census
POSTGRES_PASSWORD=replace-with-a-strong-local-password

CENSUS_DATABASE_URL=postgresql+psycopg://census:replace-with-a-strong-local-password@localhost:5432/census
CENSUS_REDIS_URL=redis://localhost:6379/0
CENSUS_SECRET_KEY=
CENSUS_ENVIRONMENT=development
CENSUS_CORS_ORIGINS=http://localhost:5173
CENSUS_ACCESS_TOKEN_EXPIRE_MINUTES=30
CENSUS_LOGIN_MAX_ATTEMPTS=5
CENSUS_LOGIN_WINDOW_SECONDS=900
CENSUS_ADMIN_REGISTRATION_KEY=
CENSUS_REQUEST_RATE_LIMIT=120
CENSUS_INCIDENT_THRESHOLD=10
# Optional absolute path to a trusted, executable scale-up hook.
CENSUS_SCALE_HOOK=
